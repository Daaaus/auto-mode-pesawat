        android:pathData="M 55.0,84.79 L 62.93,87.33 L 60.59,78.63 Z"
        android:fillColor="#D97757" />
    <path
        android:pathData="M 53.0,23.21 L 47.41,29.37 L 45.08,20.67 Z"
        android:fillColor="#D97757" />

